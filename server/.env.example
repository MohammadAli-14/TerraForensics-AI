# -------------------------------------------------------------
# VertexAI Server Environment Configuration
# GTD Intelligence & Document Analysis Platform
# -------------------------------------------------------------

SERVER_PORT=3001
JWT_SECRET="my-random-string-for-seeding-jwt-at-least-12-chars"
SIG_KEY='passphrase-at-least-32-chars-long'
SIG_SALT='salt-at-least-32-chars-long'
AUTH_TOKEN="Alibot786"

# =============================================================
# 1. Global Terrorism Database (GTD) MongoDB Integration
# =============================================================
ENABLE_MONGODB=true
MONGODB_URI=mongodb://127.0.0.1:27017/
# Or Remote Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.htbeolp.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=GTD_Database
MONGODB_COLLECTION=attacks

# =============================================================
# 2. Vector DB & Embeddings (Local Zero-Cost LanceDB)
# =============================================================
VECTOR_DB='lancedb'
EMBEDDING_ENGINE='native'

# =============================================================
# 3. LLM API Selection (Defaults to Llama 3.1:8B Free Tier)
# =============================================================

# --- OpenRouter (Recommended: Llama 3.1 8B Free Tier) ---
LLM_PROVIDER='openrouter'
OPENROUTER_API_KEY='your-openrouter-api-key'
OPENROUTER_MODEL_PREF='meta-llama/llama-3.1-8b-instruct:free'
OPENROUTER_TIMEOUT_MS='60000'

# --- Local Ollama ---
# LLM_PROVIDER='ollama'
# OLLAMA_BASE_PATH='http://127.0.0.1:11434'
# OLLAMA_MODEL_PREF='llama3.1:latest'
# OLLAMA_MODEL_TOKEN_LIMIT=8192

# --- Google Gemini ---
# LLM_PROVIDER='gemini'
# GEMINI_API_KEY='your-gemini-api-key'
# GEMINI_LLM_MODEL_PREF='gemini-2.0-flash-lite'

# --- OpenAI (BYOK) ---
# LLM_PROVIDER='openai'
# OPEN_AI_KEY='sk-your-openai-key'
# OPEN_MODEL_PREF='gpt-4o'

# --- Anthropic (BYOK) ---
# LLM_PROVIDER='anthropic'
# ANTHROPIC_API_KEY='sk-ant-your-anthropic-key'
# ANTHROPIC_MODEL_PREF='claude-3-5-sonnet-20241022'

# --- Generic OpenAI-Compatible ---
# LLM_PROVIDER='generic-openai'
# GENERIC_OPEN_AI_BASE_PATH='http://127.0.0.1:8000/v1'
# GENERIC_OPEN_AI_KEY='your-key'
# GENERIC_OPEN_AI_MODEL_PREF='model-name'

# =============================================================
# 4. Speech & TTS
# =============================================================
WHISPER_PROVIDER='local'
TTS_PROVIDER='native'