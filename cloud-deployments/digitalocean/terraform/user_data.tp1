#!/bin/bash  
# check output of userdata script with sudo tail -f /var/log/cloud-init-output.log 
  
sudo apt-get update  
sudo apt-get install -y docker.io  
sudo usermod -a -G docker ubuntu
  
sudo systemctl enable docker  
sudo systemctl start docker  
  
mkdir -p /home/VertexAI
cat <<EOF >/home/VertexAI/.env
${env_content}
EOF

sudo docker pull mintplexlabs/VertexAI
sudo docker run -d -p 3001:3001 --cap-add SYS_ADMIN -v /home/VertexAI:/app/server/storage -v /home/VertexAI/.env:/app/server/.env -e STORAGE_DIR="/app/server/storage" mintplexlabs/VertexAI
echo "Container ID: $(sudo docker ps --latest --quiet)"  
  
export ONLINE=$(curl -Is http://192.168.0.201:3001/api/ping | head -n 1|cut -d$' ' -f2)  
echo "Health check: $ONLINE"  
echo "Setup complete! VertexAI instance is now online!"  
